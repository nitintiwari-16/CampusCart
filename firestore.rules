rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'defaultHostelBlock', 'defaultRoomNumber', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
        && (!('defaultHostelBlock' in data) || (data.defaultHostelBlock is string && data.defaultHostelBlock.size() <= 100))
        && (!('defaultRoomNumber' in data) || (data.defaultRoomNumber is string && data.defaultRoomNumber.size() <= 20))
        && data.updatedAt == request.time;
    }

    function isValidHostelOrder(data) {
      return data.keys().hasAll([
          'userId',
          'orderCode',
          'customerName',
          'phone',
          'hostelBlock',
          'roomNumber',
          'slot',
          'paymentMethod',
          'itemLines',
          'subtotal',
          'discount',
          'deliveryFee',
          'total',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'orderCode',
          'customerName',
          'phone',
          'hostelBlock',
          'roomNumber',
          'slot',
          'paymentMethod',
          'itemLines',
          'subtotal',
          'discount',
          'deliveryFee',
          'total',
          'status',
          'createdAt'
        ])
        && data.userId is string
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.orderCode is string
        && data.orderCode.size() >= 4
        && data.orderCode.size() <= 24
        && data.customerName is string
        && data.customerName.size() >= 1
        && data.customerName.size() <= 100
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 20
        && data.hostelBlock is string
        && data.hostelBlock.size() >= 2
        && data.hostelBlock.size() <= 100
        && data.roomNumber is string
        && data.roomNumber.size() >= 1
        && data.roomNumber.size() <= 20
        && data.slot is string
        && data.slot.size() >= 3
        && data.slot.size() <= 60
        && data.paymentMethod in ['UPI', 'Cash on Delivery']
        && data.itemLines is list
        && data.itemLines.size() > 0
        && data.itemLines.size() <= 25
        && data.itemLines[0] is string
        && data.subtotal is number
        && data.subtotal >= 0
        && data.discount is number
        && data.discount >= 0
        && data.deliveryFee is number
        && data.deliveryFee >= 0
        && data.total is number
        && data.total >= 0
        && data.status in ['Confirmed', 'Out for Hostel Drop', 'Delivered', 'Cancelled'];
    }

    match /users/{userId}/private/profile {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming(), userId);
      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'phone', 'defaultHostelBlock', 'defaultRoomNumber', 'updatedAt']);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(orderId)
        && isValidHostelOrder(incoming())
        && incoming().status == 'Confirmed'
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isValidId(orderId)
        && existing().userId == request.auth.uid
        && isValidHostelOrder(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && existing().status == 'Confirmed'
        && incoming().status == 'Cancelled'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
  }
}
